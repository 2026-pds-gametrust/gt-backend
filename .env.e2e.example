# Runtime E2E — app real contra Mongo + LocalStack do docker-compose.
# NAO use NODE_ENV=test: isso desliga o publisher SQS e forca S3 em memoria.
NODE_ENV=development
PORT=3000

DATABASE_URI="mongodb://localhost:27017/gt-e2e?replicaSet=rs0&directConnection=true"
DATABASE_NAME=gt-e2e

GT_JWT_ACCESS_SECRET=<>=32-chars>
GT_JWT_ACCESS_TTL_SECONDS=900
GT_REFRESH_TTL_SECONDS=2592000
GT_BCRYPT_ROUNDS=10

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_USE_MEMORY=false
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_PUBLIC_BUCKET=gt-media-public
S3_RESTRICTED_BUCKET=gt-media-restricted

MESSAGING_DISABLED=false
SQS_CONSUMERS_ENABLED=true
EVENT_INPROCESS_DISPATCH=false
SQS_CONSUMER_QUEUE_URLS=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-search-listings-listing-status-changed,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-search-listings-listing-published,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-search-listings-listing-paused,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-search-catalog-category-created,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-search-catalog-category-updated,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-search-catalog-service-created,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-search-catalog-service-updated,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-verification-listings-listing-status-changed,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-verification-listings-listing-submitted,http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/gt-local-listings-verification-case-approved

SEED_ADMIN_EMAIL=admin.e2e@gamertrust.local
SEED_ADMIN_PASSWORD=<senha>
