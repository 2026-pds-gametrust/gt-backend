# Local env template — copy values; never commit real secrets
NODE_ENV=development
PORT=3000

DATABASE_URI=
DATABASE_NAME=

GT_JWT_ACCESS_SECRET=<min-32-chars>
GT_JWT_ACCESS_TTL_SECONDS=900
GT_REFRESH_TTL_SECONDS=2592000
GT_BCRYPT_ROUNDS=12

# Possession proof code (HMAC pepper; min 32 chars in non-test)
PROOF_CODE_PEPPER=<min-32-chars-secret>
