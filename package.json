{
  "name": "boilerplate",
  "description": "",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --env-file=.env src/app.ts",
    "build": "tsc -p .;yarn run copy-essentials",
    "start": "node dist/src/app.js",
    "copy-essentials": "mkdir -p dist/src/contracts && cp src/contracts/*.yaml dist/src/contracts",
    "clean": "rm -rf dist",
    "prettier": "prettier --cache --write src/**/*.ts",
    "lint": "eslint --cache .",
    "release": "yarn run semantic-release",
    "test": "yarn run test:unit && yarn run test:int",
    "test:ci": "yarn run test",
    "test:unit": "NODE_ENV=test NEW_RELIC_ENABLED=false NEW_RELIC_NO_CONFIG_FILE=true NEW_RELIC_LOG_LEVEL=error jest --config ./jest/jest.config.ts --detectOpenHandles",
    "test:int": "NODE_ENV=test NEW_RELIC_ENABLED=false NEW_RELIC_NO_CONFIG_FILE=true NEW_RELIC_LOG_LEVEL=error jest --runInBand --forceExit --config ./jest/jest.int-config.ts --detectOpenHandles",
    "test:component": "jest --runInBand --config ./jest/jest.component-config.ts --detectOpenHandles",
    "test:mutation": "npx stryker run",
    "test:coverage": "NODE_ENV=test NEW_RELIC_ENABLED=false NEW_RELIC_NO_CONFIG_FILE=true NEW_RELIC_LOG_LEVEL=error jest --coverage --runInBand --forceExit --config ./jest/jest.coverage-config.ts --detectOpenHandles",
    "seed:local": "NODE_ENV=development ts-node -r dotenv/config scripts/seed-local.ts",
    "docs:api": "node scripts/generate-frontend-api-docs.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express-rate-limit": "^6.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongodb-memory-server": "^2.3.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.12.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "prettier": "^3.5.0",
    "semantic-release": "^24.2.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "repository": "git@github.com:whitebeardit/node-boilerplate.git",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/client-sns": "^3.1105.0",
    "@aws-sdk/client-sqs": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@sauvvitech/st-packages": "^3.9.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "express-openapi-validator": "^4.13.8",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.8.3",
    "sharp": "^0.35.3",
    "traceability": "^3.2.2"
  }
}
